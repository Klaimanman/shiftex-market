# Copy to .env.local for local development. Never commit real values.
# Both values are PUBLIC by design (they ship to the browser). Security comes from RLS.
# Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "publishable" key (sb_publishable_...) or the legacy "anon" key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# NEVER put the secret / service_role key in any VITE_ variable.
